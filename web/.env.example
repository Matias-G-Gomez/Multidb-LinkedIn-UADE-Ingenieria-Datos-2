# Copiá este archivo como .env y completá tus datos (el .env no se sube a GitHub)
POSTGRES_URL=postgresql://USUARIO:PASSWORD@HOST/neondb?sslmode=require
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=linkedin_db
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
NEO4J_URI=neo4j+s://XXXXXXXX.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=TU_PASSWORD
